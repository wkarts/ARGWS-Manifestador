# Manifestador NF-e CloudPanel / Linux Headless
# Copie para .env e ajuste conforme o domínio/app no CloudPanel.

# ============================================================
# MODO DE PUBLICAÇÃO DE PORTAS
# ============================================================
# false = padrão seguro: serviços em 127.0.0.1, recomendado para CloudPanel/Nginx.
# true  = publica API/Web/Webhook/WebSocket em 0.0.0.0, útil quando você quer liberar
#         todas as portas diretamente no firewall/proxy externo.
MANIFESTADOR_NFE_PUBLISH_ALL_PORTS=false

# Quando true, além de publicar os hosts, habilita Webhook e WebSocket no start.
MANIFESTADOR_NFE_START_ALL_PORTS=false

# CloudPanel normalmente injeta PORT. Mantendo true, PORT tem prioridade sobre MANIFESTADOR_NFE_WEB_PORT.
# Para rodar direto por terminal e respeitar exatamente MANIFESTADOR_NFE_WEB_PORT, use false.
MANIFESTADOR_NFE_RESPECT_CLOUDPANEL_PORT=true

# Host público usado quando MANIFESTADOR_NFE_PUBLISH_ALL_PORTS=true.
MANIFESTADOR_NFE_PUBLIC_BIND_HOST=0.0.0.0

# ============================================================
# API INTERNA / HEADLESS API
# ============================================================
# Em CloudPanel, mantenha 127.0.0.1 e exponha por WebPort/Nginx.
# Para publicar diretamente, use MANIFESTADOR_NFE_PUBLISH_ALL_PORTS=true ou defina 0.0.0.0.
MANIFESTADOR_NFE_API_HOST=127.0.0.1
MANIFESTADOR_NFE_API_PORT=61001
MANIFESTADOR_NFE_API_AUTO_START=true
MANIFESTADOR_NFE_API_BASE_URL=http://127.0.0.1:61001
MANIFESTADOR_NFE_API_SCALAR_ENABLED=true
MANIFESTADOR_NFE_API_SCALAR_URL=http://127.0.0.1:61001/docs
MANIFESTADOR_NFE_API_DOCS_PATH=/docs
MANIFESTADOR_NFE_API_DOCS_PUBLIC_LOCAL=true
MANIFESTADOR_NFE_API_REQUIRE_TOKEN=false
MANIFESTADOR_NFE_API_ALLOW_PUBLIC_NETWORK=false
MANIFESTADOR_NFE_API_CORS=false
MANIFESTADOR_NFE_API_TOKEN_HEADER=X-App-Token
MANIFESTADOR_NFE_API_TOKEN=

# ============================================================
# WEBPORT / BROWSER / PROXY LOCAL
# ============================================================
# Se PORT existir e MANIFESTADOR_NFE_RESPECT_CLOUDPANEL_PORT=true, o launcher usa PORT.
MANIFESTADOR_NFE_WEB_ENABLED=true
MANIFESTADOR_NFE_WEB_HOST=127.0.0.1
MANIFESTADOR_NFE_WEB_PORT=61002
MANIFESTADOR_NFE_WEB_AUTO_START=true
MANIFESTADOR_NFE_WEB_BIND_LAN=false
MANIFESTADOR_NFE_WEB_DIST_DIR=./dist

# ============================================================
# WEBHOOK SERVICE
# ============================================================
MANIFESTADOR_NFE_SERVICES_AUTO_START=true
MANIFESTADOR_NFE_WEBHOOK_ENABLED=false
MANIFESTADOR_NFE_WEBHOOK_AUTO_START=false
MANIFESTADOR_NFE_WEBHOOK_HOST=127.0.0.1
MANIFESTADOR_NFE_WEBHOOK_PORT=61003
MANIFESTADOR_NFE_WEBHOOK_BASE_PATH=/webhooks
MANIFESTADOR_NFE_WEBHOOK_TOKEN_REQUIRED=true
MANIFESTADOR_NFE_WEBHOOK_TOKEN_HEADER=X-Webhook-Token
MANIFESTADOR_NFE_WEBHOOK_TOKEN=
MANIFESTADOR_NFE_WEBHOOK_ALLOW_LAN=false
MANIFESTADOR_NFE_WEBHOOK_ALLOW_EXTERNAL=false

# ============================================================
# WEBSOCKET SERVICE
# ============================================================
MANIFESTADOR_NFE_WEBSOCKET_ENABLED=false
MANIFESTADOR_NFE_WEBSOCKET_AUTO_START=false
MANIFESTADOR_NFE_WEBSOCKET_HOST=127.0.0.1
MANIFESTADOR_NFE_WEBSOCKET_PORT=61004
MANIFESTADOR_NFE_WEBSOCKET_PATH=/ws
MANIFESTADOR_NFE_WEBSOCKET_TOKEN_REQUIRED=true
MANIFESTADOR_NFE_WEBSOCKET_TOKEN_QUERY=token
MANIFESTADOR_NFE_WEBSOCKET_TOKEN_HEADER=X-WebSocket-Token
MANIFESTADOR_NFE_WEBSOCKET_TOKEN=
MANIFESTADOR_NFE_WEBSOCKET_ALLOW_LAN=false
MANIFESTADOR_NFE_WEBSOCKET_ALLOW_EXTERNAL=false
MANIFESTADOR_NFE_WEBSOCKET_HEARTBEAT_SECONDS=30

# ============================================================
# DIRETÓRIOS / BINÁRIO
# ============================================================
MANIFESTADOR_NFE_BINARY=./bin/manifestador_nfe
MANIFESTADOR_NFE_DATA_DIR=./data
MANIFESTADOR_NFE_LOGS_DIR=./logs
MANIFESTADOR_NFE_ENV_FILE=./.env

# ============================================================
# SERVIDOR LINUX SEM DESKTOP
# ============================================================
MANIFESTADOR_NFE_TRAY_ENABLED=false
MANIFESTADOR_NFE_TRAY_MINIMIZE_TO_TRAY=false
MANIFESTADOR_NFE_TRAY_CLOSE_TO_TRAY=false
MANIFESTADOR_NFE_START_WITH_WINDOWS=false
MANIFESTADOR_NFE_SERVICE_NAME=ManifestadorNFeServer
